	<div id="yellow-nexus-block_1fab3173e11d3822e3287863ec92b6e6" class="yellow-nexus">

		<div class="nexus__hero">
			<div class="wrap">
				<div class="nh__header">
					<h1 id='introducing-nexus'  id="boomdevs_1" >Introducing <strong>NEXUS</strong></h1>
					<div class="floating-list">
						<div class="floating-icon">
							<div class="bg">
								<p>The industry&#8217;s first <strong>Universal Agentic Interface (UAI)</strong></p>
							</div>
							<img loading="lazy" decoding="async" src="https://yellow.ai/wp-content/themes/yellow.ai/img/v2/icon-nexus-hand.svg" alt="Floating Icon">
						</div>
						<div class="floating-icon">
							<div class="bg">
								<p>Nexus isn&#8217;t a copilot. It&#8217;s the brain sitting above your entire stack. </p>
							</div>
							<img loading="lazy" decoding="async" src="https://yellow.ai/wp-content/themes/yellow.ai/img/v2/icon-nexus-brain.svg" alt="Floating Icon">
						</div>
						<div class="floating-icon">
							<div class="bg">
								<p>It sees <br/>everything.<br/> It builds anything. <br/>It breaks your silos,<br/> speaks your language, <br/>and knows your <br/>context. </p>
							</div>
							<img loading="lazy" decoding="async" src="https://yellow.ai/wp-content/themes/yellow.ai/img/v2/icon-nexus-eye.svg" alt="Floating Icon">
						</div>
						<div class="floating-icon">
							<div class="bg">
								<video src="https://yellow.ai/wp-content/uploads/2026/02/nexus-sec2-video.mp4"loop playsinline></video> 
							</div>
							<img loading="lazy" decoding="async" src="https://yellow.ai/wp-content/themes/yellow.ai/img/v2/icon-nexus-youtube.svg" alt="Floating Icon">
						</div>
						<div class="floating-icon">
							<div class="bg">
								<p>Describe what you want, and it&#8217;s done in minutes.</p> 
							</div>
							<img loading="lazy" decoding="async" src="https://yellow.ai/wp-content/themes/yellow.ai/img/v2/icon-nexus-edit.svg" alt="Floating Icon">
						</div>
