		<!-- SECTION 4: Three Pillars & Nexus Effect -->
		<div class="nexus__sec4">
			<div class="nexus__sec4--wrap">
				<div class="ns4__slider">
					<h2 id='the-three-pillars-of-nexus'  id="boomdevs_5" >The Three <br />Pillars of <strong>Nexus</strong></h2>
					<div class="ns4__slider--wrap">
													<div class="slider slider1">
								<div class="slider-wrap">
									<div class="nss__left">
										<div class="cateogry">Eyes</div>
										<h3 id='not-retrieval-understanding'  id="boomdevs_6" >Not retrieval. Understanding.</h3>
										<div class="content">
											<ul>
<li>Analyzes hundreds of thousands of conversations across channels</li>
<li>Finds patterns humans miss</li>
<li>Sees how your processes connect, customers behave, data relates</li>
<li>Builds a living model of your business, not a static index</li>
</ul>
										</div>
									</div>
									<div class="nss__right">
										<img loading="lazy" decoding="async" width="988" height="816" src="https://yellow.ai/wp-content/uploads/2026/02/nexus-pillar-1.webp" class="attachment-full size-full" alt="" srcset="https://yellow.ai/wp-content/uploads/2026/02/nexus-pillar-1.webp 988w, https://yellow.ai/wp-content/uploads/2026/02/nexus-pillar-1-300x248.webp 300w, https://yellow.ai/wp-content/uploads/2026/02/nexus-pillar-1-768x634.webp 768w, https://yellow.ai/wp-content/uploads/2026/02/nexus-pillar-1-150x124.webp 150w" sizes="(max-width: 988px) 100vw, 988px" />									</div>
								</div>
							</div>
														<div class="slider slider2">
								<div class="slider-wrap">
									<div class="nss__left">
										<div class="cateogry">Hands</div>
										<h3 id='not-suggestions-execution'  id="boomdevs_7" >Not suggestions. Execution.</h3>
										<div class="content">
											<ul>
<li>Tell Nexus what you need in natural language</li>
<li>It builds the workflow, generates the UI, connects your systems</li>
<li>No nodes to drag. No fields to configure. No tickets to file</li>
<li>You describe, it delivers</li>
</ul>
										</div>
									</div>
									<div class="nss__right">
										<img loading="lazy" decoding="async" width="988" height="816" src="https://yellow.ai/wp-content/uploads/2026/02/nexus-pillar-2.webp" class="attachment-full size-full" alt="" srcset="https://yellow.ai/wp-content/uploads/2026/02/nexus-pillar-2.webp 988w, https://yellow.ai/wp-content/uploads/2026/02/nexus-pillar-2-300x248.webp 300w, https://yellow.ai/wp-content/uploads/2026/02/nexus-pillar-2-768x634.webp 768w, https://yellow.ai/wp-content/uploads/2026/02/nexus-pillar-2-150x124.webp 150w" sizes="(max-width: 988px) 100vw, 988px" />									</div>
								</div>
							</div>
														<div class="slider slider3">
								<div class="slider-wrap">
									<div class="nss__left">
										<div class="cateogry">Autonomy</div>
										<h3 id='not-assistance-authority-for-action'  id="boomdevs_8" >Not assistance. Authority for action.</h3>
										<div class="content">
											<ul>
<li>Tests itself against thousands of simulated users</li>
<li>Catches prompt injections before attackers do</li>
<li>When something breaks, it diagnoses and fixes, within the guardrails you define</li>
<li>You stay in control, without doing the work</li>
</ul>
										</div>
									</div>
									<div class="nss__right">
										<img loading="lazy" decoding="async" width="988" height="816" src="https://yellow.ai/wp-content/uploads/2026/02/nexus-pillar-3.webp" class="attachment-full size-full" alt="" srcset="https://yellow.ai/wp-content/uploads/2026/02/nexus-pillar-3.webp 988w, https://yellow.ai/wp-content/uploads/2026/02/nexus-pillar-3-300x248.webp 300w, https://yellow.ai/wp-content/uploads/2026/02/nexus-pillar-3-768x634.webp 768w, https://yellow.ai/wp-content/uploads/2026/02/nexus-pillar-3-150x124.webp 150w" sizes="(max-width: 988px) 100vw, 988px" />									</div>
								</div>
							</div>
												</div>
				</div>
			</div>
