	<div id="yellow-nexus-vox-block_5dbea6e39c27e4d89c8fdae3e5d8da32" class="yellow-nexus-vox">
		<section class="vox__hero">
			<div class="wrap">
				<h1 id='introducing-nexus-vox'  id="boomdevs_1" >Introducing Nexus VOX</h1>
				<h2 id='record-your-voice-for-10-seconds-hear-it-speak-500-languages'  id="boomdevs_2" >Record your voice for 10 seconds. Hear it speak 500 languages.</h2>
				<p>The first enterprise voice AI that sounds like a specific human — yours, your CEO&#8217;s, anyone&#8217;s that your
					customers and employees would trust — in almost every language on Earth. Built to sound like you, understands
					anyone, and most importantly, gets things done.</p>
				<div class="vox__audio--wrap">
					<div class="vox__audio" data-state="idle">
						<div class="va__stage">
							<a href="#" class="va__audio">
								<span class="va__bg-wrap">
									<img loading="lazy" decoding="async" src="https://yellow.ai/wp-content/themes/yellow.ai/img/v2/vox-audio.webp" class="va__bg" alt="">
								</span>
								<img loading="lazy" decoding="async" src="https://yellow.ai/wp-content/themes/yellow.ai/img/v2/icon-vox-audio.svg"
									class="va__icon va__icon-audio" alt="">
								<img loading="lazy" decoding="async" src="https://yellow.ai/wp-content/themes/yellow.ai/img/v2/icon-vox-play.svg"
									class="va__icon va__icon-play" alt="">
							</a>
							<p class="va__time">00:10</p>
							<p class="va__hint">
								<span class="va__hint-idle">Speak something now</span>
								<span class="va__hint-recording">Recording&#8230;</span>
								<span class="va__hint-preview">Preview your recording and hit Clone My Voice</span>
							</p>
						</div>
						<div class="va__result">
							<div class="va__demo-text" contenteditable="plaintext-only" role="textbox" aria-multiline="true"
								aria-label="Demo text — edit, then press play to hear it in your voice" spellcheck="false">Hi there,
								thanks for reaching out! Tell me what you need help with, and I’ll help get it sorted.</div>
						</div>
						<div class="va__controls">
							<div class="va__controls-left">
								<div class="va__lang">
									<select class="va__lang-select" aria-label="Playback language">
										<option value="English">English</option>
										<option value="Arabic">Arabic</option>
										<option value="Bengali">Bengali</option>
										<option value="Chinese">Chinese</option>
										<option value="French">French</option>
										<option value="German">German</option>
										<option value="Hindi">Hindi</option>
										<option value="Italian">Italian</option>
										<option value="Japanese">Japanese</option>
										<option value="Malay">Malay</option>
										<option value="Marathi">Marathi</option>
										<option value="Portuguese">Portuguese</option>
										<option value="Russian">Russian</option>
										<option value="Spanish">Spanish</option>
										<option value="Tamil">Tamil</option>
										<option value="Telugu">Telugu</option>
										<option value="Thai">Thai</option>
